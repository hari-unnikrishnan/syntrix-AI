# Django
DJANGO_SECRET_KEY=replace-with-a-long-random-secret
DJANGO_DEBUG=True
DJANGO_ALLOWED_HOSTS=127.0.0.1,localhost

# MySQL
DB_NAME=syntrix_ai
DB_USER=syntrix_user
DB_PASSWORD=replace-with-your-mysql-password
DB_HOST=localhost
DB_PORT=3306
DB_CONNECT_TIMEOUT=5
DB_CONN_MAX_AGE=60

# Private uploaded-file storage (never served as a public static directory)
MEDIA_ROOT=
MAX_DOCUMENT_UPLOAD_BYTES=10485760

# OpenAI (leave empty to use the clearly labelled demo response mode)
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini

# Used by frontend/.env.local
VITE_API_URL=http://127.0.0.1:8000/api
VITE_BASE_PATH=/
