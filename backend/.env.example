# Django
DJANGO_SECRET_KEY=replace-with-a-long-random-secret
DJANGO_DEBUG=True
DJANGO_ALLOWED_HOSTS=127.0.0.1,localhost
DJANGO_CSRF_TRUSTED_ORIGINS=
DJANGO_SECURE_HSTS_SECONDS=0

# Optional production database URL (PostgreSQL or MySQL). When set, this takes
# precedence over the DB_* MySQL settings below. Keep credentials private.
DATABASE_URL=

# MySQL (used when DATABASE_URL is empty and SQLite is disabled)
DB_NAME=syntrix_ai
DB_USER=syntrix_user
DB_PASSWORD=replace-with-your-mysql-password
DB_HOST=127.0.0.1
DB_PORT=3306
DB_CONNECT_TIMEOUT=5
DB_CONN_MAX_AGE=60

# Local development only: set both values to enable the SQLite database.
DJANGO_USE_SQLITE=False

# Cross-origin browser access. Use exact origins without trailing slashes.
CORS_ALLOWED_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# Production static files and persistent private document storage.
STATIC_ROOT=
MEDIA_ROOT=
MAX_DOCUMENT_UPLOAD_BYTES=10485760

# Optional; keep your key on the backend and never use a VITE_ prefix.
OPENAI_API_KEY=
OPENAI_MODEL=gpt-5.1
